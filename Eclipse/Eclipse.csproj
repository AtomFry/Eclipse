<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <!-- BigBox resolves the plugin and the theme XAML by this exact assembly name. Do not change. -->
    <AssemblyName>Eclipse</AssemblyName>
    <RootNamespace>Eclipse</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Properties\AssemblyInfo.cs is checked in and remains the source of assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <!-- Eclipse is a plugin, not a referenced library: BigBox will not resolve its dependencies
         from Eclipse.deps.json, so package assemblies must land in the output to be deployed. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Deterministic>true</Deterministic>
    <!-- The Eclipse\ payload folder contains LaunchBox theme XAML that must never be compiled as WPF pages. -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <!-- CA1416: the WPF markup-compile pass builds through a generated temp project that loses the
         windows platform annotation, so every Screen/GDI+/Speech call reports as cross-platform.
         Eclipse only ever runs inside BigBox on Windows; the analysis is not meaningful here. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <!-- Path to the LaunchBox plugin contract assembly. Defaults to the vendored LaunchBox 14
         copy so the build is reproducible without a LaunchBox install; override locally to point
         at another copy (e.g. a different LaunchBox version's Core directory).
         The historical netstandard2.0 contract remains checked in beside the project as
         Milestone 0 reference material and is deliberately no longer referenced. -->
    <LaunchBoxPluginsDll Condition="'$(LaunchBoxPluginsDll)' == ''">$(MSBuildProjectDirectory)\lib\LaunchBox14\Unbroken.LaunchBox.Plugins.dll</LaunchBoxPluginsDll>
    <!-- Optional. Set to a LaunchBox root to deploy on build; empty = stage into bin only. -->
    <LaunchBoxDeployRoot Condition="'$(LaunchBoxDeployRoot)' == ''"></LaunchBoxDeployRoot>
  </PropertyGroup>

  <!-- WPF pages, listed explicitly because default page globbing is disabled above. -->
  <ItemGroup>
    <Page Include="View\MainWindowView.xaml" />
    <Page Include="View\EclipseSettings\EclipseSettingsView.xaml" />
    <Page Include="View\EclipseSettings\CustomListDefinitionEditView.xaml" />
  </ItemGroup>

  <!-- Images embedded into the assembly and addressed via pack://application:,,,/Eclipse;component/resources.
       Listed individually: the Resources folder also holds unused files that were never embedded. -->
  <ItemGroup>
    <Resource Include="Resources\DefaultBezelHorizontal.png" />
    <Resource Include="Resources\DefaultBezelVertical.png" />
    <Resource Include="Resources\EclipseSettingsIcon1.png" />
    <Resource Include="Resources\LaunchBoxLogo.png" />
    <Resource Include="Resources\MoreInfo_Selected.png" />
    <Resource Include="Resources\MoreInfo_Unselected.png" />
    <Resource Include="Resources\NES_BoxFront_Template.png" />
    <Resource Include="Resources\PlayButton_Selected.png" />
    <Resource Include="Resources\PlayButton_Unselected.png" />
    <Resource Include="Resources\ProgressBarImageBrush.png" />
    <Resource Include="Resources\SettingsIcon_Grey.png" />
    <Resource Include="Resources\SettingsIcon_White.png" />
    <Resource Include="Resources\VoiceRecognitionGif.gif" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Eclipse\README.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="Prism.Core" Version="8.1.97" />
    <!-- System.Drawing.Common is supplied by the Windows Desktop framework reference on
         net10.0-windows (NU1510); no explicit PackageReference is needed or wanted. -->
    <PackageReference Include="System.Speech" Version="10.0.11" />
    <PackageReference Include="WpfAnimatedGif" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Unbroken.LaunchBox.Plugins">
      <HintPath>$(LaunchBoxPluginsDll)</HintPath>
      <!-- The host loads its own contract assembly. Shipping a second copy would put two
           Unbroken.LaunchBox.Plugins identities in one process and break the interface cast. -->
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Staging must run as a target, not a PostBuildEvent property: in an SDK-style project a
       body PropertyGroup is evaluated before the SDK defines $(TargetDir), which would expand empty.
       Uses MSBuild tasks rather than shell commands so the deploy step is guarded by a real
       MSBuild condition instead of a cmd-level "if", which does not survive Exec reliably. -->
  <Target Name="StageEclipsePayload" AfterTargets="Build">
    <PropertyGroup>
      <EclipseStageDir>$(TargetDir)Eclipse\</EclipseStageDir>
    </PropertyGroup>

    <RemoveDir Directories="$(EclipseStageDir)" />

    <ItemGroup>
      <EclipsePayload Include="$(MSBuildProjectDirectory)\Eclipse\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(EclipsePayload)"
          DestinationFiles="@(EclipsePayload->'$(EclipseStageDir)%(RecursiveDir)%(Filename)%(Extension)')" />

    <!-- LaunchBox 13+ discovers plugins in per-plugin folders. Plugins\Eclipse\ already holds
         Eclipse's Media and Settings data, so code and data share one folder and every path in
         DirectoryInfoHelper continues to resolve unchanged.
         Eclipse.deps.json is included deliberately: if the host's load context consults it,
         dependency resolution works with no extra machinery on our side. -->
    <ItemGroup>
      <EclipseBinaries Include="$(TargetDir)*.dll" />
      <EclipseBinaries Include="$(TargetDir)Eclipse.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(EclipseBinaries)"
          DestinationFolder="$(EclipseStageDir)LaunchBox\Plugins\Eclipse" />

    <!-- Deployment is opt-in. Empty LaunchBoxDeployRoot stages into bin only. -->
    <ItemGroup Condition="'$(LaunchBoxDeployRoot)' != '' And Exists('$(LaunchBoxDeployRoot)')">
      <StagedForDeploy Include="$(EclipseStageDir)LaunchBox\**\*" />
    </ItemGroup>
    <Copy Condition="'$(LaunchBoxDeployRoot)' != '' And Exists('$(LaunchBoxDeployRoot)')"
          SourceFiles="@(StagedForDeploy)"
          DestinationFiles="@(StagedForDeploy->'$(LaunchBoxDeployRoot)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
