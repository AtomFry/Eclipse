<Project>

  <!-- ===================================================================================
       Eclipse per-developer build settings — TEMPLATE

       Copy this file to "Eclipse.csproj.user" (drop the .template extension) and edit the
       path below. The copy is git-ignored, so your machine's paths never reach the repo.

           copy Eclipse.csproj.user.template Eclipse.csproj.user

       Visual Studio and msbuild import Eclipse.csproj.user automatically. No command-line
       arguments and no build-configuration changes are needed.

       See docs/DEVELOPMENT.md for the full setup guide.
       =================================================================================== -->

  <PropertyGroup>

    <!-- LaunchBoxDeployRoot
         The root of the LaunchBox installation to deploy into after every successful
         build. This is the folder that contains Core, Plugins, Themes and Data.

           Example:  <LaunchBoxDeployRoot>D:\LaunchBox</LaunchBoxDeployRoot>

         Leave it empty to stage into bin only and copy nothing. That is the default, and
         it is deliberately the safe one - a fresh clone cannot deploy into a LaunchBox
         install you did not mean to touch.

         Close LaunchBox and Big Box before building; a running host locks Eclipse.dll. -->
    <LaunchBoxDeployRoot></LaunchBoxDeployRoot>

  </PropertyGroup>

</Project>
