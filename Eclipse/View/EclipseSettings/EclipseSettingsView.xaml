<Window x:Class="Eclipse.View.EclipseSettings.EclipseSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:Eclipse.View.EclipseSettings"
        xmlns:models="clr-namespace:Eclipse.Models"
        xmlns:converters="clr-namespace:Eclipse.Converters"
        mc:Ignorable="d"
        Title="Manage eclipse" 
        Height="700" 
        Width="1100" 
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        AllowsTransparency="True" 
        ResizeMode="CanResizeWithGrip" 
        MouseDoubleClick="Window_MouseDoubleClick" 
        MouseDown="Window_MouseDown">
    <Window.Resources>
        <!-- The window's palette, named once. These six colours were previously written out as
             literals at every control that used them - #D3D3D5 appeared 110 times, "10,2" 68
             times, #343542 46 times - so changing the scheme meant a find-and-replace across the
             whole file. -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#2A2B34"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#3F404E"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#4D4F61"/>
        <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#343542"/>
        <SolidColorBrush x:Key="TextBrush" Color="#D3D3D5"/>
        <SolidColorBrush x:Key="TitleTextBrush" Color="#F0F0F0"/>
        <!-- The one hue in the window, picked up from the selected tab in the list on the left so
             that the filled part of a slider reads as the same family. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#5A80B8"/>

        <!-- The three field types are completely uniform: all 23 CheckBoxes, all 4 ComboBoxes and
             all 18 Sliders carried the same five attributes, every time. That was measured before
             these styles were written, so they change nothing on screen.

             Labels are not uniform - their margins and alignment vary with where they sit - so
             their style carries only the foreground they all share. The one label that is not
             #D3D3D5 (the window title) sets its own, and a local value beats a style setter. -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="SettingFieldStyle" TargetType="Control">
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Background" Value="{StaticResource FieldBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <!-- Slider is the third control Aero2 renders against this window's palette rather than
             with it: the track came out bright and thick, and the thumb is the large pennant you
             get whenever TickPlacement is set.

             The template inverts the emphasis. The channel is darker than the panel so it reads
             as recessed; the portion left of the thumb is filled in the accent, so the value can
             be read from the bar without parsing the number; the thumb is small and light.

             Tick marks are gone. Every slider had TickPlacement set with a frequency nobody
             revisited - the video delay drew ten thousand of them across six hundred pixels,
             sixteen to a pixel. That is not a scale, it is a grey smear. TickFrequency now does
             one useful job instead: it is the snap step. -->
        <Style x:Key="SliderChannelStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Name="Grip" CornerRadius="2"
                                Background="{StaticResource TextBrush}"
                                BorderBrush="{StaticResource WindowBackgroundBrush}" BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider" BasedOn="{StaticResource SettingFieldStyle}">
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <!-- Click the track and the thumb goes there, rather than paging towards it. On a
                 range of ten thousand milliseconds, paging is not a way to get anywhere. -->
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{StaticResource PanelBorderBrush}"/>
                            <Track Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderChannelStyle}"
                                                  Background="{StaticResource AccentBrush}"
                                                  Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderChannelStyle}"
                                                  Background="Transparent"
                                                  Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caption, value and track as one thing. See SliderRow.cs for why. -->
        <Style TargetType="local:SliderRow">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:SliderRow">
                        <Grid Margin="10,7,10,7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{TemplateBinding Label}"
                                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Left"/>

                            <!-- The value sits at the far end of the track it belongs to, so the
                                 eye runs caption, value, bar. It used to be a third label wedged
                                 up against the caption with the unit after it. -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <Label Padding="0"
                                       Content="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}"
                                       ContentStringFormat="{TemplateBinding ValueFormat}"/>
                                <Label Padding="0" Margin="4,0,0,0" Content="{TemplateBinding Unit}"/>
                            </StackPanel>

                            <Slider Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,0,0"
                                    Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                    Minimum="{TemplateBinding Minimum}"
                                    Maximum="{TemplateBinding Maximum}"
                                    TickFrequency="{TemplateBinding Step}"
                                    SmallChange="{TemplateBinding Step}"
                                    LargeChange="{TemplateBinding Step}"
                                    IsEnabled="{TemplateBinding IsEnabled}"
                                    ToolTip="{TemplateBinding ToolTip}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox needs a template too, for the mirror image of the ComboBox problem below.
             Aero2 *does* honour Background on a check box - it fills the box with it - but the
             tick itself is painted with a hard-coded dark glyph brush that cannot be reached from
             outside the theme. A dark box with a dark tick in it is a check box you cannot read.
             Under Aero the tick was light and showed up against the same dark box.

             The tick is drawn from the control's own Foreground, so it follows the palette. -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource SettingFieldStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <!-- transparent so the whole row is clickable, as the stock template is -->
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border Name="Box" Width="15" Height="15" VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                                <Path Name="Tick" Margin="2" Stretch="Uniform"
                                      Data="M 0,4 L 3,7.5 L 9,0"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                      StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox needs a template, unlike the other two.

             Setting Background on a ComboBox has no effect under the Aero2 theme that .NET Core
             and later ship: its chrome is hard-coded light. Under Aero, which .NET Framework 4.8
             used, Background was honoured - so this window's dark fields survived the framework
             move on every control except this one, leaving #D3D3D5 text on near-white and the
             selected value almost unreadable.

             This is the smallest template that renders the value, opens the list and honours the
             control's own Background and Foreground. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource FieldBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PanelBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource SettingFieldStyle}">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                                  Data="M 0 0 L 8 0 L 4 5 Z"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,0,24,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource FieldBackgroundBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Deliberately no implicit TextBlock or Button style. DataGridTextColumn generates
             TextBlocks and would inherit one, and the custom-list buttons are unstyled WPF
             defaults today - restyling them would be a visible change, which this is not. -->

        <!-- The bar at the top of each tab, and the smaller one that divides a long tab into
             sections. Both were a Border wrapping a TextBlock, written out at each of the nine
             places they appear. A ContentControl with a template rather than a custom control:
             there is no behaviour here, only a shape, and this needs no new class or file. -->
        <Style x:Key="SectionHeaderStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Height="35" Background="{StaticResource WindowBackgroundBrush}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="5,5,5,10">
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubSectionHeaderStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Height="28" Background="{StaticResource WindowBackgroundBrush}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="5,15,5,5">
                            <TextBlock Text="{TemplateBinding Content}" Margin="10,0"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One row of a settings tab.

             Tabs used to be a Grid with a pasted block of twenty-five Auto rows and eight star
             columns, and every control placed by hand-written Grid.Row / Grid.Column /
             Grid.ColumnSpan. Six of the seven tabs declared twenty-five rows whatever they held,
             and inserting a setting meant renumbering all hundred Grid.Row attributes below it -
             with nothing to catch a mistake, because two controls given the same row just
             overlap. Tabs are StackPanels now: order is document order and there are no indices.

             The eight columns resolved to only three widths in practice - full, half, and a
             label beside a field - so there are three row styles. They keep the original
             proportions (1/8, 3/8, 8/8) rather than sizing to content: shared sizing would
             align labels more neatly but would move every field horizontally, and the brief is
             that the window already looks right. -->
        <Style x:Key="SettingRowStyle" TargetType="HeaderedContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="4*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="{TemplateBinding Header}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,2"/>
                            <ContentPresenter Grid.Column="1"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HalfWidthRowStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="4*"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ObjectDataProvider x:Key="PageFunctionEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:PageFunction"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="SearchKeyboardLayoutEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:SearchKeyboardLayout"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="AdditionalVersionDisplayFieldEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:AdditionalApplicationDisplayField"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

    </Window.Resources>
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="15"/>
        </Grid.ColumnDefinitions>

        <!-- The seven tabs.

             They used to be seven full-size Grids stacked in this cell, each gated on its own
             Visibility property - so all seven were built and live at all times, six of them
             Collapsed, and adding a tab meant editing a string constant, a collection, a
             Visibility property, a thirty-two line switch and the panel. Four of those five were
             bookkeeping.

             As templates, only the selected tab is realised, and a tab is declared in one place.
             Note that Content below is bound to the view model, not to the tab name: bind it to
             the name and the DataContext inside every template becomes a string, and every
             binding in the tab breaks without erroring. -->
        <Grid.Resources>
            <DataTemplate x:Key="ListSettingsTab">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ContentControl Grid.Row="0" Style="{StaticResource SectionHeaderStyle}" Content="List settings"/>

                <StackPanel Grid.Row="1">
                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="Default group">
                        <ComboBox ToolTip="Specify which list category group to load by default on startup"
                                  SelectedItem="{Binding Settings.DefaultListCategoryType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding DefaultListTypes}"/>
                    </HeaderedContentControl>

                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.ShowGameCountInList, Mode=TwoWay}"
                                  ToolTip="Check this box to show the count of games after the list descriptions"
                                  Content="Show game count in list description"/>
                    </ContentControl>

                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.IncludeBrokenGames, Mode=TwoWay}"
                                  ToolTip="Check this box to include games marked broken in lists"
                                  Content="Include broken games"/>
                    </ContentControl>

                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.IncludeHiddenGames, Mode=TwoWay}"
                                  ToolTip="Check this box to include games marked hidden in lists"
                                  Content="Include hidden games"/>
                    </ContentControl>

                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.RepeatGamesToFillScreen, Mode=TwoWay}"
                                  ToolTip="Check this box to make games repeat so that lists fill the screen"
                                  Content="Repeat games to fill screen"/>
                    </ContentControl>
                </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="InputSettingsTab">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ContentControl Grid.Row="0" Style="{StaticResource SectionHeaderStyle}" Content="Input settings"/>

                <StackPanel Grid.Row="1">
                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="Page up">
                        <ComboBox ToolTip="Specify the functionality of the page up button"
                                  SelectedItem="{Binding Settings.PageUpFunction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding Source={StaticResource PageFunctionEnum}}"/>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="Page down">
                        <ComboBox ToolTip="Specify the functionality of the page down button"
                                  SelectedItem="{Binding Settings.PageDownFunction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding Source={StaticResource PageFunctionEnum}}"/>
                    </HeaderedContentControl>

                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.EnableTextSearch, Mode=TwoWay}"
                                  ToolTip="Check this box to enable searching for games with an on-screen keyboard"
                                  Content="Enable search"/>
                    </ContentControl>

                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="Keyboard layout">
                        <ComboBox ToolTip="Which on-screen keyboard the search screen shows. Alphabetical is easier to navigate without knowing the layout in advance"
                                  SelectedItem="{Binding Settings.SearchKeyboardLayout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding Source={StaticResource SearchKeyboardLayoutEnum}}"/>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="Search suggestions">
                        <TextBox Text="{Binding Settings.SearchMaxSuggestions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="How many metadata filter suggestions the search screen offers at once. Zero turns suggestions off."/>
                    </HeaderedContentControl>

                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.EnableVoiceSearch, Mode=TwoWay}"
                                  ToolTip="Check this box to enable voice search functionality"
                                  Content="Enable voice search"/>
                    </ContentControl>

                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.OpenSettingsPaneOnLeft, Mode=TwoWay}"
                                  ToolTip="Check this box to allow the settings pane to open when you are on the first game in a list and you press left.  Note - escape also opens the settings pane."
                                  Content="Open settings pane on left press"/>
                    </ContentControl>

                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.BypassDetails, Mode=TwoWay}"
                                  ToolTip="Check this box to bypass game details and start a game when selecting a game with the enter button"
                                  Content="Bypass details"/>
                    </ContentControl>
                </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="VersionSettingsTab">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ContentControl Grid.Row="0" Style="{StaticResource SectionHeaderStyle}" Content="Game version settings"/>

                <StackPanel Grid.Row="1">
                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.AdditionalVersionsEnable, Mode=TwoWay}"
                                  ToolTip="Check this box to enable playing additional game versions that are combined with a game as additional applications from the game details screen"
                                  Content="Enable additional versions"/>
                    </ContentControl>

                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="Display field">
                        <ComboBox ToolTip="Specify the additional application field to display for versions"
                                  SelectedItem="{Binding Settings.AdditionalApplicationDisplayField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding Source={StaticResource AdditionalVersionDisplayFieldEnum}}"/>
                    </HeaderedContentControl>

                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.AdditionalVersionsRemovePlayPrefix, Mode=TwoWay}"
                                  ToolTip="Check this to remove &quot;Play&quot; from the start of the version description so that it does not repeat."
                                  Content="Suppress &quot;Play&quot; from version description"/>
                    </ContentControl>

                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.AdditionalVersionsRemoveVersionPostfix, Mode=TwoWay}"
                                  ToolTip="Check this to remove &quot;Version...&quot; from the end of the version description."
                                  Content="Suppress &quot;Version...&quot; from version description"/>
                    </ContentControl>

                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.AdditionalVersionsOnlyEmulatorOrDosBox, Mode=TwoWay}"
                                  ToolTip="Check this box to exclude additional apps that do not have an emulator or dos box path."
                                  Content="Only additional versions with emulators"/>
                    </ContentControl>

                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.AdditionalVersionsExcludeRunBefore, Mode=TwoWay}"
                                  ToolTip="Check this box to exclude additional apps that are set to run before games launch."
                                  Content="Exclude run before"/>
                    </ContentControl>

                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.AdditionalVersionsExcludeRunAfter, Mode=TwoWay}"
                                  ToolTip="Check this box to exclude additional apps that are set to run after games launch."
                                  Content="Exclude run after"/>
                    </ContentControl>
                </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- The selected game sequence, in the order it happens: the dim, the settle, the
                 fades, then the video. Video delay lived on Other settings until these five
                 joined it, at which point the sequence was described in two places. -->
            <DataTemplate x:Key="PresentationSettingsTab">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ContentControl Grid.Row="0" Style="{StaticResource SectionHeaderStyle}" Content="Presentation settings"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SubSectionHeaderStyle}" Content="Changing game"/>

                        <local:SliderRow Label="Selection settles after" Unit="ms"
                                         Minimum="0" Maximum="5000" Step="50"
                                         Value="{Binding Settings.SelectionSettleMilliseconds, Mode=TwoWay}"
                                         ToolTip="How long the selection has to be still before the game's artwork and details are loaded and shown. Longer means less happens while you scroll through a list"/>

                        <local:SliderRow Label="Dim outgoing game" Unit="ms"
                                         Minimum="0" Maximum="1000" Step="25"
                                         Value="{Binding Settings.SelectionDimMilliseconds, Mode=TwoWay}"
                                         ToolTip="How quickly the previous game's background and details dim when you move. Short on purpose - this is the instant feedback that the selection changed"/>

                        <ContentControl Style="{StaticResource SubSectionHeaderStyle}" Content="Fades"/>

                        <local:SliderRow Label="Game details fade in" Unit="ms"
                                         Minimum="0" Maximum="5000" Step="50"
                                         Value="{Binding Settings.SelectionDetailsFadeInMilliseconds, Mode=TwoWay}"
                                         ToolTip="How long the clear logo, game title and details take to fade in once the selection has settled"/>

                        <local:SliderRow Label="Background fade in" Unit="ms"
                                         Minimum="0" Maximum="5000" Step="50"
                                         Value="{Binding Settings.SelectionBackgroundFadeInMilliseconds, Mode=TwoWay}"
                                         ToolTip="How long the background artwork takes to fade in - both when a new game settles and when it returns after a video preview ends"/>

                        <local:SliderRow Label="Background fade out" Unit="ms"
                                         Minimum="0" Maximum="10000" Step="250"
                                         Value="{Binding Settings.SelectionBackgroundFadeOutMilliseconds, Mode=TwoWay}"
                                         ToolTip="How long the background artwork takes to fade out behind a video preview"/>

                        <ContentControl Style="{StaticResource SubSectionHeaderStyle}" Content="Video preview"/>

                        <local:SliderRow Label="Video delay" Unit="ms"
                                         Minimum="0" Maximum="10000" Step="250"
                                         Value="{Binding Settings.VideoDelayInMilliseconds, Mode=TwoWay}"
                                         ToolTip="How long the new game's artwork holds the screen before the video preview takes over. Zero starts the video as soon as the artwork is loaded, without the background fade in"/>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="OtherSettingsTab">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ContentControl Grid.Row="0" Style="{StaticResource SectionHeaderStyle}" Content="Other settings"/>

                <StackPanel Grid.Row="1">
                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.DisableVideos, Mode=TwoWay}"
                                  ToolTip="Check this box to disable game preview videos"
                                  Content="Disable videos"/>
                    </ContentControl>

                    <local:SliderRow Label="Default video volume" ValueFormat="P0"
                                     Minimum="0" Maximum="1" Step="0.05"
                                     Value="{Binding Settings.DefaultVideoVolume, Mode=TwoWay}"
                                     ToolTip="Volume for videos (default 50%)"/>

                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.ShowMatchPercent, Mode=TwoWay}"
                                  ToolTip="Check this box to display the game match percent"
                                  Content="Show match percent"/>
                    </ContentControl>
                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.ShowReleaseYear, Mode=TwoWay}"
                                  ToolTip="Check this box to display the game release year"
                                  Content="Show release year"/>
                    </ContentControl>
                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.ShowStarRating, Mode=TwoWay}"
                                  ToolTip="Check this box to display the game star rating"
                                  Content="Show star rating"/>
                    </ContentControl>
                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.ShowPlayMode, Mode=TwoWay}"
                                  ToolTip="Check this box to display the game play mode"
                                  Content="Show play mode"/>
                    </ContentControl>
                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.ShowPlatformLogo, Mode=TwoWay}"
                                  ToolTip="Check this box to display the game platform logo"
                                  Content="Show platform logo"/>
                    </ContentControl>
                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.ShowOptionsIcon, Mode=TwoWay}"
                                  ToolTip="Check this box to display the options icon"
                                  Content="Show options icon"/>
                    </ContentControl>
                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.DisplayFeaturedGame, Mode=TwoWay}"
                                  ToolTip="Check this box to display the featured game"
                                  Content="Display featured game"/>
                    </ContentControl>
                    <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                        <CheckBox IsChecked="{Binding Settings.DisplayOptionsOnEscape, Mode=TwoWay}"
                                  ToolTip="Check this box to display eclipse options when you press escape"
                                  Content="Display eclipse options on escape"/>
                    </ContentControl>
                </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CustomListsTab">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ContentControl Grid.Row="0" Style="{StaticResource SectionHeaderStyle}" Content="Custom lists"/>
                <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid Grid.Row="0" Grid.Column="0" Margin="5,0"
                        ItemsSource="{Binding CustomListDefinitions}"
                        SelectedItem="{Binding SelectedCustomListDefinition, Mode=TwoWay}"
                        RowBackground="{StaticResource FieldBackgroundBrush}"
                        AutoGenerateColumns="False" 
                        IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" 
                        RowHeaderWidth="0">
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Description" Width="*" Binding="{Binding Description}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                        <Button Content="Add" Width="75" Margin="5,0" Command="{Binding AddCommand}"/>
                        <Button Content="Edit" Width="75" Margin="5,0" Command="{Binding EditCommand}"/>
                        <Button Content="Delete" Width="75" Margin="5,0" Command="{Binding DeleteCommand}"/>
                        <Button Content="Move up" Width="80" Height="30" Command="{Binding MoveUpCustomListCommand}" />
                        <Button Content="Move down" Width="80" Height="30" Command="{Binding MoveDownCustomListCommand}" />
                    </StackPanel>
                </Grid>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="BoxMarginTab">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ContentControl Grid.Row="0" Style="{StaticResource SectionHeaderStyle}" Content="Box margins"/>

                <StackPanel Grid.Row="1">
                    <!-- These four bind to the view model rather than straight to Settings: their
                         setters refresh the preview below, which is the only side effect left in
                         the settings view model after the triplication was collapsed. -->
                    <local:SliderRow Label="Left margin" Unit="px" Minimum="0" Maximum="100" Step="1"
                                     Value="{Binding BoxFrontMarginLeft, Mode=TwoWay}"
                                     ToolTip="Margin on left side of box front image"/>
                    <local:SliderRow Label="Top margin" Unit="px" Minimum="0" Maximum="100" Step="1"
                                     Value="{Binding BoxFrontMarginTop, Mode=TwoWay}"
                                     ToolTip="Margin on top side of box front image"/>
                    <local:SliderRow Label="Right margin" Unit="px" Minimum="0" Maximum="100" Step="1"
                                     Value="{Binding BoxFrontMarginRight, Mode=TwoWay}"
                                     ToolTip="Margin on right side of box front image"/>
                    <local:SliderRow Label="Bottom margin" Unit="px" Minimum="0" Maximum="100" Step="1"
                                     Value="{Binding BoxFrontMarginBottom, Mode=TwoWay}"
                                     ToolTip="Margin on bottom side of box front image"/>

                    <StackPanel Margin="10,2" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                        <Rectangle Height="200" Width="200" Fill="{StaticResource WindowBackgroundBrush}" Margin="{Binding MarginSample}"/>
                        <Rectangle Height="200" Width="200" Fill="{StaticResource WindowBackgroundBrush}" Margin="{Binding MarginSample}"/>
                        <Rectangle Height="200" Width="200" Fill="{StaticResource WindowBackgroundBrush}" Margin="{Binding MarginSample}"/>
                        <Rectangle Height="200" Width="200" Fill="{StaticResource WindowBackgroundBrush}" Margin="{Binding MarginSample}"/>
                    </StackPanel>

                    <local:SliderRow Label="Game details padding" Unit="px" Minimum="0" Maximum="100" Step="1"
                                     Value="{Binding Settings.SelectedGameDetailsPadding, Mode=TwoWay}"
                                     ToolTip="Game details padding"/>
                </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ScreenSaverTab">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ContentControl Grid.Row="0" Style="{StaticResource SectionHeaderStyle}" Content="Screen saver settings"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ContentControl Style="{StaticResource HalfWidthRowStyle}">
                            <CheckBox IsChecked="{Binding Settings.EnableScreenSaver, Mode=TwoWay}"
                                      ToolTip="Check this box to enable the screen saver"
                                      Content="Enable screen saver"/>
                        </ContentControl>

                        <local:SliderRow Label="Start after" Unit="s" Minimum="10" Maximum="600" Step="5"
                                         Value="{Binding Settings.ScreensaverDelayInSeconds, Mode=TwoWay}"
                                         IsEnabled="{Binding Settings.EnableScreenSaver}"
                                         ToolTip="How long Eclipse waits with no input before the screen saver starts"/>

                        <ContentControl Style="{StaticResource SubSectionHeaderStyle}" Content="Slide sequence"/>

                        <local:SliderRow Label="Delay between images" Unit="ms" Minimum="0" Maximum="15000" Step="250"
                                         Value="{Binding Settings.ScreensaverDelayBetweenImagesMilliseconds, Mode=TwoWay}"
                                         IsEnabled="{Binding Settings.EnableScreenSaver}"
                                         ToolTip="How long from one game starting to fade out until the next one starts to fade in. This overlaps the background fade out, so the screen is only fully black for the remainder"/>

                        <local:SliderRow Label="Background fade in" Unit="ms" Minimum="0" Maximum="10000" Step="250"
                                         Value="{Binding Settings.ScreensaverBackgroundFadeInMilliseconds, Mode=TwoWay}"
                                         IsEnabled="{Binding Settings.EnableScreenSaver}"
                                         ToolTip="How long each game's background image takes to fade in from black"/>

                        <local:SliderRow Label="Pan across screen" Unit="ms" Minimum="1000" Maximum="60000" Step="500"
                                         Value="{Binding Settings.ScreensaverPanMilliseconds, Mode=TwoWay}"
                                         IsEnabled="{Binding Settings.EnableScreenSaver}"
                                         ToolTip="How long the background image takes to drift across the screen. Longer is slower and gentler. Set this longer than the time on each game so the image never appears to stop"/>

                        <local:SliderRow Label="Logo appears after" Unit="ms" Minimum="0" Maximum="30000" Step="250"
                                         Value="{Binding Settings.ScreensaverLogoDelayMilliseconds, Mode=TwoWay}"
                                         IsEnabled="{Binding Settings.EnableScreenSaver}"
                                         ToolTip="How long after the background image appears before the game's logo fades in. Keep this shorter than the time on each game"/>

                        <local:SliderRow Label="Logo fade in" Unit="ms" Minimum="0" Maximum="5000" Step="100"
                                         Value="{Binding Settings.ScreensaverLogoFadeInMilliseconds, Mode=TwoWay}"
                                         IsEnabled="{Binding Settings.EnableScreenSaver}"
                                         ToolTip="How long the game's logo takes to fade in"/>

                        <local:SliderRow Label="Time on each game" Unit="ms" Minimum="2000" Maximum="120000" Step="500"
                                         Value="{Binding Settings.ScreensaverGameDurationMilliseconds, Mode=TwoWay}"
                                         IsEnabled="{Binding Settings.EnableScreenSaver}"
                                         ToolTip="How long each game is shown before it fades out and the next one is chosen"/>

                        <ContentControl Style="{StaticResource SubSectionHeaderStyle}" Content="Fades"/>

                        <local:SliderRow Label="Background fade out" Unit="ms" Minimum="0" Maximum="10000" Step="250"
                                         Value="{Binding Settings.ScreensaverBackgroundFadeOutMilliseconds, Mode=TwoWay}"
                                         IsEnabled="{Binding Settings.EnableScreenSaver}"
                                         ToolTip="How long the background image takes to fade out before the next game"/>

                        <local:SliderRow Label="Logo fade out" Unit="ms" Minimum="0" Maximum="5000" Step="100"
                                         Value="{Binding Settings.ScreensaverLogoFadeOutMilliseconds, Mode=TwoWay}"
                                         IsEnabled="{Binding Settings.EnableScreenSaver}"
                                         ToolTip="How long the game's logo takes to fade out before the next game"/>

                        <local:SliderRow Label="Screen saver fade in" Unit="ms" Minimum="0" Maximum="5000" Step="100"
                                         Value="{Binding Settings.ScreensaverFadeInMilliseconds, Mode=TwoWay}"
                                         IsEnabled="{Binding Settings.EnableScreenSaver}"
                                         ToolTip="How long the screen saver takes to fade in when it first starts"/>

                        <local:SliderRow Label="Exit fade out" Unit="ms" Minimum="0" Maximum="3000" Step="100"
                                         Value="{Binding Settings.ScreensaverExitFadeMilliseconds, Mode=TwoWay}"
                                         IsEnabled="{Binding Settings.EnableScreenSaver}"
                                         ToolTip="How quickly the screen saver disappears when you press a key"/>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </DataTemplate>

        </Grid.Resources>

        <!-- The margin used to be 15,10,15,25, which left 15px of a 50px row for content - and a
             Label needs about 29px once its default 5px padding is counted. The title overflowed
             the row and the panel rectangles below, declared later, painted over it. The icon is
             pinned so that giving the row back its height does not scale it up. -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="15,0,15,0"
              VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Height="20" Margin="0,2,0,0"
               RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Source="{Binding IconUri}"/>

            <Label Grid.Column="1" Margin="5,0,0,0" Padding="0"
                   Foreground="{StaticResource TitleTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"
                   FontStyle="Normal" FontWeight="Bold" Content="Manage eclipse" />
        </Grid>

        <StackPanel Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Content="X" FontFamily="Browallia New" FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                    Click="Button_Click" BorderThickness="0" Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource TextBrush}"  Height="30" Width="45" IsTabStop="False" />
        </StackPanel>

        <Rectangle Grid.Row="1" Grid.Column="1" Fill="{StaticResource PanelBorderBrush}" Stretch="Fill" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
        <Rectangle Grid.Row="1" Grid.Column="1" Fill="{StaticResource PanelBackgroundBrush}" Stretch="Fill" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="1"/>

        <ListBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TabPages}" 
                 SelectedItem="{Binding SelectedTabPage, Mode=TwoWay}"
                 Background="{StaticResource PanelBackgroundBrush}" Foreground="{StaticResource TextBrush}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                 Margin="1" BorderThickness="0"/>

        <Rectangle Grid.Row="1" Grid.Column="3" Fill="{StaticResource PanelBorderBrush}" Stretch="Fill" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
        <Rectangle Grid.Row="1" Grid.Column="3" Fill="{StaticResource PanelBackgroundBrush}" Stretch="Fill" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="1"/>


        <ContentControl Grid.Row="1" Grid.Column="3" Content="{Binding}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabPage}" Value="Lists">
                            <Setter Property="ContentTemplate" Value="{StaticResource ListSettingsTab}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabPage}" Value="Inputs">
                            <Setter Property="ContentTemplate" Value="{StaticResource InputSettingsTab}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabPage}" Value="Versions">
                            <Setter Property="ContentTemplate" Value="{StaticResource VersionSettingsTab}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabPage}" Value="Presentation">
                            <Setter Property="ContentTemplate" Value="{StaticResource PresentationSettingsTab}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabPage}" Value="Other">
                            <Setter Property="ContentTemplate" Value="{StaticResource OtherSettingsTab}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabPage}" Value="Custom lists">
                            <Setter Property="ContentTemplate" Value="{StaticResource CustomListsTab}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabPage}" Value="Margin">
                            <Setter Property="ContentTemplate" Value="{StaticResource BoxMarginTab}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabPage}" Value="Screen saver">
                            <Setter Property="ContentTemplate" Value="{StaticResource ScreenSaverTab}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Right">
            <Button Content="Save" Width="80" Height="30" Command="{Binding SaveCommand}"
                    Background="{StaticResource PanelBackgroundBrush}" Foreground="{StaticResource TextBrush}" Margin="5,0" />
            <Button Content="Cancel" Click="Button_Click" Width="80" Height="30" Background="{StaticResource PanelBackgroundBrush}" Foreground="{StaticResource TextBrush}"/>
        </StackPanel>
    </Grid>
</Window>