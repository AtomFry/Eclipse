<UserControl x:Class="Eclipse.View.AttractModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:myconverters="clr-namespace:Eclipse.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             IsHitTestVisible="False"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Name="AttractModeUserControl">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <myconverters:BackgroundImageOversizeConverter x:Key="OversizeImageConverter"/>
    </UserControl.Resources>

    <!-- The control itself is sized to the window; this grid is deliberately larger, and the
         overhang is what the pan slides across. Sizes bind to this control rather than to the
         main window, so the attract mode UI no longer depends on an ancestor's name. -->
    <Grid   Name="Grid_AttractMode"
            IsHitTestVisible="False"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Panel.ZIndex="900"
            Background="Black"
            Width="{Binding ActualWidth, ElementName=AttractModeUserControl, Converter={StaticResource OversizeImageConverter}}"
            Height="{Binding ActualHeight, ElementName=AttractModeUserControl, Converter={StaticResource OversizeImageConverter}}"
            Visibility="{Binding IsDisplayingAttractMode, Converter={StaticResource BoolToVis}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Canvas Name="Canvas_AttractModeCanvas"
                Grid.Row="0"
                Grid.RowSpan="18"
                Grid.Column="0"
                Grid.ColumnSpan="32"
                IsHitTestVisible="False"
                Panel.ZIndex="901">

            <Canvas Name="Canvas_AttractModeInnerCanvas"
                    Width="{Binding ActualWidth, ElementName=Canvas_AttractModeCanvas}"
                    Height="{Binding ActualHeight, ElementName=Canvas_AttractModeCanvas}"
                    IsHitTestVisible="False">

                <!-- Height must be set as well as Width. With only Width, UniformToFill
                     derives the height from the image's own aspect ratio, so any artwork
                     proportionally wider than the display left black bars above and below. -->
                <Image Name="Image_AttractModeBackgroundImage"
                   VerticalAlignment="Center"
                   Stretch="UniformToFill"
                   Width="{Binding ActualWidth, ElementName=AttractModeUserControl, Converter={StaticResource OversizeImageConverter}}"
                   Height="{Binding ActualHeight, ElementName=AttractModeUserControl, Converter={StaticResource OversizeImageConverter}}"
                   RenderOptions.BitmapScalingMode="HighQuality" >
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                            <LinearGradientBrush.GradientStops>
                                <GradientStop Offset="0" Color="Transparent"/>
                                <GradientStop Offset="0.25" Color="Black"/>
                            </LinearGradientBrush.GradientStops>
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>
            </Canvas>
        </Canvas>

        <!-- Darken the background when displaying feature and more info (helps with text visibility) -->
        <!-- NOTE: this is not an attract mode element - it is bound to IsDisplayingFeature and
             was already nested inside this grid, which is collapsed unless attract mode is on.
             Moved verbatim to keep behaviour identical; see the plan for the open question. -->
        <Rectangle Grid.Row="0" Grid.RowSpan="18"
                   Grid.Column="0" Grid.ColumnSpan="32"
                   IsHitTestVisible="False"
                   Fill="Black" Opacity="0.1"
                   Panel.ZIndex="902"
                   Visibility="{Binding IsDisplayingFeature, Converter={StaticResource BoolToVis}}">
        </Rectangle>

        <Image Name="Image_AttractModeClearLogo" HorizontalAlignment="Center" VerticalAlignment="Stretch"
               IsHitTestVisible="False"
               Panel.ZIndex="903"
               Grid.Row="2" Grid.RowSpan="6"
               Grid.Column="1" Grid.ColumnSpan="12"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality">
        </Image>
    </Grid>
</UserControl>
