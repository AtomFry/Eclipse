<UserControl x:Class="Eclipse.View.MainWindowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Eclipse.View"
             xmlns:myconverters="clr-namespace:Eclipse.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Name="MainWindowUserControl">
    <UserControl.DataContext>
        <local:MainWindowViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <myconverters:AddThenDivideByNegative1Converter x:Key="PreviousGameOffset"/>
        <myconverters:DivideByConverter x:Key="DivideBy3" A="3"/>
        <myconverters:DivideByConverter x:Key="DivideByNegative1" A="-1"/>
        <myconverters:GameMatchToSettingsOpacityConverter x:Key="SettingsOpacityConverter"/>
        <myconverters:DisplayingFeatureOffsetConverter x:Key="FeatureOffsetConverter"/>
        <myconverters:DisplayingFeatureLogoOffsetConverter x:Key="FeatureLogoOffsetConverter"/>
        <myconverters:DisplayingFeatureVideoOffsetConverter x:Key="FeatureVideoOffsetConverter"/>
        <myconverters:IsFeatureToRowSpanConverter x:Key="FeatureToRowSpanConverter"/>
        <myconverters:IsFeatureToColumnSpanConverter x:Key="FeatureToColumnSpanConverter"/>
        <myconverters:IsFeatureToColumnStartConverter x:Key="FeatureToColumnStartConverter"/>
        <myconverters:BooleanToVisibilityConverter x:Key="InvertBooleanToVisibilityConverter" True="Collapsed" False="Visible"/>
        <myconverters:BooleanToStringConverter x:Key="FavoriteToFavoriteOptionConverter" True="Remove from favorites" False="Add to favorites"/>
        <myconverters:BooleanToFontWeightConverter x:Key="SelectedToOptionFontWeightConverter" True="UltraBlack" False="Light"/>
        <myconverters:BooleanToBrushConverter x:Key="SelectedToOptionBrushConverter" True="GhostWhite" False="DimGray"/>
        <myconverters:FeatureOptionToDoubleConverter x:Key="PlayGameOpacityConverter" PlayGameValue="1.0" MoreInfoValue="0.5"/>
        <myconverters:FeatureOptionToDoubleConverter x:Key="MoreInfoOpacityConverter" PlayGameValue="0.5" MoreInfoValue="1.0"/>
        <myconverters:StringLengthToVisibilityConverter x:Key="StringLengthVisibilityConverter" Empty="Collapsed" NonEmpty="Visible"/>
        <myconverters:StringLengthToVisibilityConverter x:Key="InvertStringLengthVisibilityConverter" Empty="Visible" NonEmpty="Collapsed"/>
        <myconverters:BooleanToPointCollectionConverter x:Key="FavoriteDetailIconConverter" 
                                                        False="20,0 30,0 30,20 50,20 50,30 30,30 30,50 20,50 20,30 0,30 0,20 20,20"
                                                        True="0,20 30,20 30,25 0,25"/>

        <myconverters:BackgroundImageOversizeConverter x:Key="OversizeImageConverter"/>
        <!-- Game detail overlay options.
             Selection used to be expressed with nine converters that each compared an enum to
             a constant; a trigger on the Selected flag of the option says the same thing. -->
        <Style x:Key="GameDetailOptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="WhiteSmoke"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GameDetailOptionIcon" TargetType="Polygon">
            <Setter Property="Fill" Value="WhiteSmoke"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter Property="Fill" Value="Black"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- the More like this icon also strokes, and its stroke inverts against the fill -->
        <Style x:Key="GameDetailOptionOutlinedIcon" TargetType="Polygon" BasedOn="{StaticResource GameDetailOptionIcon}">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="FillRule" Value="Nonzero"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter Property="Stroke" Value="WhiteSmoke"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="PlayOptionIcon">
            <Polygon Points="10,10 10,70 70,40" Style="{StaticResource GameDetailOptionIcon}"/>
        </DataTemplate>
        <DataTemplate x:Key="FavoriteOptionIcon">
            <Polygon Points="{Binding DataContext.CurrentGameList.SelectedGame.Favorite, ElementName=MainWindowUserControl, Converter={StaticResource FavoriteDetailIconConverter}}"
                     Style="{StaticResource GameDetailOptionIcon}"/>
        </DataTemplate>
        <DataTemplate x:Key="MoreLikeThisOptionIcon">
            <Polygon Points="20,20 60,20 60,60 20,60 20,20
                             40,20 40,40 20,40 20,20
                             60,20 60,40 40,40 40,20
                             60,20 60,60 40,60 40,40 60,40 60,60
                             20,60 20,40 40,40 40,60 20,60 20,20"
                     Style="{StaticResource GameDetailOptionOutlinedIcon}"/>
        </DataTemplate>
        <DataTemplate x:Key="RatingOptionIcon">
            <Polygon Points="80,0 105,50 160,55 120,90 130,145 80,120 30,145 40,90 0,55 55,50"
                     Style="{StaticResource GameDetailOptionIcon}"/>
        </DataTemplate>

        <DataTemplate x:Key="PlayOptionBody">
            <Grid>
                <TextBlock Text="Play"
                           Style="{StaticResource GameDetailOptionText}"
                           Visibility="{Binding DataContext.CurrentGameList.SelectedGame.GameFiles.GameVersionList.HasAdditionalVersions, ElementName=MainWindowUserControl, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                <TextBlock Style="{StaticResource GameDetailOptionText}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding DataContext.CurrentGameList.SelectedGame.GameFiles.GameVersionList.HasAdditionalVersions, ElementName=MainWindowUserControl, Converter={StaticResource BoolToVis}}">
                    <Run Text="Play "/>
                    <Run Text="{Binding DataContext.CurrentGameList.SelectedGame.GameFiles.GameVersionList.SelectedGameVersion.Description, ElementName=MainWindowUserControl}"/>
                </TextBlock>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="FavoriteOptionBody">
            <TextBlock Text="{Binding DataContext.CurrentGameList.SelectedGame.Favorite, ElementName=MainWindowUserControl, Converter={StaticResource FavoriteToFavoriteOptionConverter}}"
                       Style="{StaticResource GameDetailOptionText}"/>
        </DataTemplate>
        <DataTemplate x:Key="MoreLikeThisOptionBody">
            <TextBlock Text="More like this" Style="{StaticResource GameDetailOptionText}"/>
        </DataTemplate>
        <DataTemplate x:Key="RatingOptionBody">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock x:Name="TextBlock_DetailStarRatingButton"
                           Text="Rating" Margin="0,0,25,0"
                           Style="{StaticResource GameDetailOptionText}"/>
                <!-- Unfilled stars are near-white on a white button, so the outline is what
                     makes them readable. -->
                <local:StarRatingView Rating="{Binding DataContext.CurrentGameList.SelectedGame.UserRating, ElementName=MainWindowUserControl}"
                                      Visibility="{Binding DataContext.IsRatingGame, ElementName=MainWindowUserControl, Converter={StaticResource BoolToVis}}"
                                      Height="{Binding ActualHeight, ElementName=TextBlock_DetailStarRatingButton}"
                                      Fill="Black" Empty="WhiteSmoke"
                                      Stroke="Black" StrokeThickness="5"
                                      VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- One row of the overlay: shared chrome, with the icon and body swapped per option. -->
        <DataTemplate x:Key="GameDetailOptionRow">
            <Grid IsHitTestVisible="False" Margin="10,0,0,0"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="OptionBorder"
                        Background="Transparent"
                        CornerRadius="8,8,8,8"
                        IsHitTestVisible="False"
                        Grid.Row="0" Grid.RowSpan="3"
                        Grid.Column="0" Grid.ColumnSpan="1"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16*"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="OptionIcon" Grid.Column="0" Content="{Binding}"/>
                        <ContentPresenter x:Name="OptionBody" Grid.Column="1" Content="{Binding}" Margin="25,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="OptionBorder" Property="Background" Value="WhiteSmoke"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Play">
                    <Setter TargetName="OptionIcon" Property="ContentTemplate" Value="{StaticResource PlayOptionIcon}"/>
                    <Setter TargetName="OptionBody" Property="ContentTemplate" Value="{StaticResource PlayOptionBody}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Favorite">
                    <Setter TargetName="OptionIcon" Property="ContentTemplate" Value="{StaticResource FavoriteOptionIcon}"/>
                    <Setter TargetName="OptionBody" Property="ContentTemplate" Value="{StaticResource FavoriteOptionBody}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="MoreLikeThis">
                    <Setter TargetName="OptionIcon" Property="ContentTemplate" Value="{StaticResource MoreLikeThisOptionIcon}"/>
                    <Setter TargetName="OptionBody" Property="ContentTemplate" Value="{StaticResource MoreLikeThisOptionBody}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Rating">
                    <Setter TargetName="OptionIcon" Property="ContentTemplate" Value="{StaticResource RatingOptionIcon}"/>
                    <Setter TargetName="OptionBody" Property="ContentTemplate" Value="{StaticResource RatingOptionBody}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>
    <Canvas Background="Black" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
            IsHitTestVisible="False"
            Width="{Binding ActualWidth, ElementName=MainWindowUserControl}"
            Height="{Binding ActualHeight, ElementName=MainWindowUserControl}">

        <!-- LOADING -->
        <Grid   IsHitTestVisible="False"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Background="Black"
                Width="{Binding ActualWidth, ElementName=MainWindowUserControl}"
                Height="{Binding ActualHeight, ElementName=MainWindowUserControl}"
                Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVis}}">
        </Grid>
        <!-- END LOADING -->

        <!-- ATTRACT MODE - visuals and their animations live in AttractModeView -->
        <local:AttractModeView x:Name="AttractModeView_Control"
                IsHitTestVisible="False"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Panel.ZIndex="900"
                Width="{Binding ActualWidth, ElementName=MainWindowUserControl}"
                Height="{Binding ActualHeight, ElementName=MainWindowUserControl}"/>
        
        <!-- DISPLAY ERROR -->
        <Grid   Background="Transparent"
                IsHitTestVisible="False"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Panel.ZIndex="1000"
                Width="{Binding ActualWidth, ElementName=MainWindowUserControl}"
                Height="{Binding ActualHeight, ElementName=MainWindowUserControl}"
                Visibility="{Binding IsDisplayingError, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Rectangle  Grid.Row="2"
                        Grid.RowSpan="1"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"        
                        Fill="Black">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Offset="0" Color="Transparent"/>
                            <GradientStop Offset="0.2" Color="Black"/>
                            <GradientStop Offset="0.8" Color="Black"/>
                            <GradientStop Offset="1" Color="Transparent"/>
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>            
            
            <StackPanel Grid.Row="2"
                        Grid.RowSpan="1"
                        IsHitTestVisible="False"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock Text="{Binding ErrorMessage}"
                           IsHitTestVisible="False"
                       Foreground="GhostWhite"
                       FontFamily="Calibri"
                       FontSize="48"
                       TextWrapping="Wrap"
                       Width="{Binding ActualWidth, ElementName=MainWindowUserControl}"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                <!-- What to do about it, where there is something to do. Collapsed otherwise, so
                     a message with no way forward does not pretend to offer one. -->
                <TextBlock Text="{Binding ErrorHint}"
                           Visibility="{Binding ErrorHint, Converter={StaticResource StringLengthVisibilityConverter}}"
                           IsHitTestVisible="False"
                       Margin="0,16,0,0"
                       Foreground="DarkGray"
                       FontFamily="Calibri"
                       FontSize="28"
                       TextWrapping="Wrap"
                       Width="{Binding ActualWidth, ElementName=MainWindowUserControl}"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <!-- END DISPLAY ERROR -->

        <!-- DISPLAYING RESULTS -->
        <Grid   Background="Transparent"
                IsHitTestVisible="False"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Width="{Binding ActualWidth, ElementName=MainWindowUserControl}"
                Height="{Binding ActualHeight, ElementName=MainWindowUserControl}"
                Visibility="{Binding IsDisplayingResults, Converter={StaticResource BoolToVis}}">
            <!-- 18 rows -->
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <!-- 32 columns -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Options Icon -->
            <StackPanel Name="StackPanel_OptionsIcon"
                        IsHitTestVisible="False"
                        Grid.Row="10" Grid.RowSpan="1" 
                        Grid.Column="0" Grid.ColumnSpan="1"
                        Orientation="Vertical"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="{Binding IsDisplayingMoreInfo, Converter={StaticResource InvertBooleanToVisibilityConverter}}"
                        Opacity="{Binding CurrentGameList.PreviousGame, Converter={StaticResource SettingsOpacityConverter}}"
                        Panel.ZIndex="800">
                <Image Name="Image_SettingsIcon" 
                       IsHitTestVisible="False"
                       Source="{Binding SettingsIconWhite}"
                       HorizontalAlignment="Stretch" 
                       VerticalAlignment="Stretch"
                       Visibility="{Binding Settings.ShowOptionsIcon, Converter={StaticResource BoolToVis}}"
                       Height="{Binding ActualHeight, ElementName=TextBlock_CurrentGameListDescription}"                       
                       RenderOptions.BitmapScalingMode="HighQuality" 
                       Margin="2,2,2,2"
                       Stretch="Uniform"/>
            </StackPanel>

            <!-- Picking Category -->
            <Grid Name="Grid_PickingOptions"
                  IsHitTestVisible="False"
                  Grid.Row="0" Grid.RowSpan="18"
                  Grid.Column="0" Grid.ColumnSpan="32"
                  Panel.ZIndex="900"
                  Visibility="{Binding IsPickingCategory, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6.64*"/>
                    <ColumnDefinition Width="1.37*"/>
                    <ColumnDefinition Width="3.91*"/>
                    <ColumnDefinition Width="27.34*"/>
                    <ColumnDefinition Width="60.75*"/>
                </Grid.ColumnDefinitions>

                <!-- Backdrop for options - black rectangle that fades to transparent -->
                <Rectangle Name="Rectangle_PickingOptionsBackground"
                           IsHitTestVisible="False"
                           Grid.Row="0" Grid.RowSpan="12"
                           Grid.Column="0" Grid.ColumnSpan="5"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Fill="Black">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <LinearGradientBrush.GradientStops>
                                <GradientStop Offset="0" Color="Black"/>
                                <GradientStop Offset="0.2" Color="Black"/>
                                <GradientStop Offset="1" Color="Transparent"/>
                            </LinearGradientBrush.GradientStops>
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>

                
                
                <ItemsControl ItemsSource="{Binding OptionList.DisplayedListCategoryTypes}" 
                              Grid.Row="1" Grid.RowSpan="10"
                              Grid.Column="1" Grid.ColumnSpan="3"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding LongDescription}"
                                       IsHitTestVisible="False"
                                       Margin="0,5"
                                       FontFamily="Calibri" 
                                       FontWeight="{Binding Selected, Converter={StaticResource SelectedToOptionFontWeightConverter}}"                                       
                                       FontSize="26" 
                                       Foreground="{Binding Selected, Converter={StaticResource SelectedToOptionBrushConverter}}"
                                       TextAlignment="Left"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Darken the background when displaying feature and more info (helps with text visibility) -->
            <Rectangle Grid.Row="0" Grid.RowSpan="18" Grid.Column="0" Grid.ColumnSpan="32" Fill="Black" Opacity="0.1" 
                       Panel.ZIndex="499"
                       IsHitTestVisible="False"
                       Visibility="{Binding IsDisplayingFeature, Converter={StaticResource BoolToVis}}">
            </Rectangle>

            <!-- Selected game logo and details -->
            <Grid Name="Grid_Selected_Game_Heading"
                  IsHitTestVisible="False"
                  Grid.Row="1" Grid.RowSpan="16"
                  Grid.Column="1" Grid.ColumnSpan="16"
                  Panel.ZIndex="500"
                  Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.RenderTransform>
                    <TranslateTransform>
                        <TranslateTransform.Y>
                            <MultiBinding Converter="{StaticResource FeatureLogoOffsetConverter}">
                                <Binding Path="IsDisplayingFeature"/>
                                <Binding Path="IsDisplayingMoreInfo"/>
                                <Binding ElementName="CurrentListGrid" Path="ActualHeight"/>
                            </MultiBinding>
                        </TranslateTransform.Y>
                    </TranslateTransform>
                </Grid.RenderTransform>

                <!-- Displaying the game clear logo for the selected game -->
                <Image Name="Image_Displayed_GameClearLogo"
                        Grid.Row="0"
                        IsHitTestVisible="False"
                        Panel.ZIndex="510"
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Bottom"
                        RenderOptions.BitmapScalingMode="HighQuality" 
                        Visibility="{Binding CurrentGameList.SelectedGame.GameFiles.ClearLogo.AbsoluteUri, Converter={StaticResource StringLengthVisibilityConverter}}"
                        Stretch="Uniform"/>

                <!-- Game title to be displayed if clear logo is missing -->
                <TextBlock Name="TextBlock_Displayed_GameTitle"
                           Grid.Row="0"
                           IsHitTestVisible="False"
                           Panel.ZIndex="509"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                            FontFamily="Arial" 
                            FontWeight="Bold"
                            FontSize="36" 
                            Foreground="WhiteSmoke"
                            TextTrimming="None"
                            TextWrapping="Wrap"
                            Visibility="{Binding CurrentGameList.SelectedGame.GameFiles.ClearLogo.AbsoluteUri, Converter={StaticResource InvertStringLengthVisibilityConverter}}"
                            RenderOptions.BitmapScalingMode="HighQuality">
                </TextBlock>

                <Border Grid.Row="1"
                        Padding="{Binding SelectedGameDetailsPadding}"
                        Margin="0,5">
                    <Grid Name="Grid_SelectedGameDetails">

                    <!-- Selected game details-->
                    <StackPanel Name="StackPanel_SelectedGameDetails"
                                Orientation="Horizontal"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                        <Viewbox StretchDirection="Both" 
                                 VerticalAlignment="Stretch" 
                                 Stretch="Uniform" 
                                 Margin="0,0,15,0"
                                 Visibility="{Binding Settings.ShowMatchPercent, Converter={StaticResource BoolToVis}}">
                            <TextBlock Name="TextBlock_MatchPercentage"
                                    FontFamily="Arial" 
                                    FontWeight="Bold"
                                    Foreground="#43C764"
                                    HorizontalAlignment="Center"/>
                        </Viewbox>

                        <Viewbox StretchDirection="Both" 
                                 VerticalAlignment="Stretch" 
                                 Stretch="Uniform" 
                                 Margin="0,0,15,0"
                                 Visibility="{Binding Settings.ShowReleaseYear, Converter={StaticResource BoolToVis}}">
                            <TextBlock  Name="TextBlock_ReleaseYear"
                                    FontFamily="Arial" 
                                    FontWeight="Bold"
                                    Foreground="WhiteSmoke"
                                    HorizontalAlignment="Center"/>
                        </Viewbox>

                        <!-- the user's rating overlays the community's - both reserve the full
                             five-star width, so they line up whatever the ratings are -->
                        <Grid   Margin="0,0,15,0"
                                Visibility="{Binding Settings.ShowStarRating, Converter={StaticResource BoolToVis}}"
                                VerticalAlignment="Stretch">
                            <local:StarRatingView Rating="{Binding CurrentGameList.SelectedGame.CommunityRating}"
                                                  Fill="WhiteSmoke"
                                                  VerticalAlignment="Stretch"/>
                            <local:StarRatingView Rating="{Binding CurrentGameList.SelectedGame.UserRating}"
                                                  Fill="Red"
                                                  VerticalAlignment="Stretch"/>
                        </Grid>
                        <Image  Name="Image_Playmode"  
                                Margin="0,0,15,0" 
                                Visibility="{Binding Settings.ShowPlayMode, Converter={StaticResource BoolToVis}}"
                                RenderOptions.BitmapScalingMode="HighQuality" 
                                VerticalAlignment="Stretch"
                                Stretch="Uniform"/>
                        <Image  Name="Image_PlatformLogo"
                                Margin="0,0,15,0"                
                                Visibility="{Binding Settings.ShowPlatformLogo, Converter={StaticResource BoolToVis}}"
                                RenderOptions.BitmapScalingMode="HighQuality" 
                                VerticalAlignment="Stretch"                                
                                Stretch="Uniform"/>
                    </StackPanel>
                </Grid>
                </Border>

                <Grid Grid.Row="2" Grid.RowSpan="1"
                      IsHitTestVisible="False"
                      Visibility="{Binding IsDisplayingFeature, Converter={StaticResource BoolToVis}}"
                      Width="{Binding ActualWidth, ElementName=StackPanel_SelectedGameDetails}"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel x:Name="StackPanel_FeatureButtons" 
                                IsHitTestVisible="False"
                                Visibility="{Binding IsDisplayingMoreInfo, Converter={StaticResource InvertBooleanToVisibilityConverter}}"
                                Orientation="Horizontal"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                        <Image  Name="Image_PlayButton" 
                                IsHitTestVisible="False"
                                RenderOptions.BitmapScalingMode="HighQuality" 
                                Height="{Binding ActualHeight, ElementName=Grid_SelectedGameDetails}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Stretch="Uniform"
                                Margin="5,5,5,5"
                                Opacity="{Binding FeatureOption, Converter={StaticResource PlayGameOpacityConverter}}"
                                Source="{Binding PlayButtonImage}"/>
                        <Image Name="Image_MoreInfoButton"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality" 
                               Height="{Binding ActualHeight, ElementName=Grid_SelectedGameDetails}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Stretch"
                               Stretch="Uniform"
                               Margin="5,5,5,5"
                               Opacity="{Binding FeatureOption, Converter={StaticResource MoreInfoOpacityConverter}}"
                               Source="{Binding MoreInfoImage}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2"
                      Grid.RowSpan="1"
                      IsHitTestVisible="False"
                      Visibility="{Binding IsDisplayingMoreInfo, Converter={StaticResource BoolToVis}}"
                      Width="{Binding ActualWidth, ElementName=StackPanel_SelectedGameDetails}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <StackPanel Orientation="Vertical"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding CurrentGameList.SelectedGame.Genre, Converter={StaticResource StringLengthVisibilityConverter}}">
                            <TextBlock Text="Genres:"       
                                       IsHitTestVisible="False"
                                       Foreground="DarkGray" TextWrapping="Wrap" TextTrimming="None" 
                                       VerticalAlignment="Stretch" HorizontalAlignment="Stretch" TextAlignment="Left" 
                                       FontFamily="Arial" FontSize="20"/>
                            <TextBlock Text="{Binding CurrentGameList.SelectedGame.Genre}"
                                       IsHitTestVisible="False"
                                   Foreground="WhiteSmoke" TextWrapping="Wrap" TextTrimming="None" 
                                   Margin="10,0,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" TextAlignment="Left" 
                                   FontFamily="Arial" FontSize="20"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding CurrentGameList.SelectedGame.Series, Converter={StaticResource StringLengthVisibilityConverter}}">
                            <TextBlock Text="Series:"       
                                       IsHitTestVisible="False"
                                       Foreground="DarkGray" TextWrapping="Wrap" TextTrimming="None" 
                                       VerticalAlignment="Stretch" HorizontalAlignment="Stretch" TextAlignment="Left" 
                                       FontFamily="Arial" FontSize="20"/>
                            <TextBlock Text="{Binding CurrentGameList.SelectedGame.Series}"
                                       IsHitTestVisible="False"
                                   Foreground="WhiteSmoke" TextWrapping="Wrap" TextTrimming="None" 
                                   Margin="10,0,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" TextAlignment="Left" 
                                   FontFamily="Arial" FontSize="20"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding CurrentGameList.SelectedGame.Developer, Converter={StaticResource StringLengthVisibilityConverter}}">
                            <TextBlock Text="Developer:"    
                                       IsHitTestVisible="False"
                                       Foreground="DarkGray" TextWrapping="Wrap" TextTrimming="None" 
                                       VerticalAlignment="Stretch" HorizontalAlignment="Stretch" TextAlignment="Left" 
                                       FontFamily="Arial" FontSize="20"/>
                            <TextBlock Text="{Binding CurrentGameList.SelectedGame.Developer}"
                                       IsHitTestVisible="False"
                                   Foreground="WhiteSmoke" TextWrapping="Wrap" TextTrimming="None" 
                                   Margin="10,0,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" TextAlignment="Left" 
                                   FontFamily="Arial" FontSize="20"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding CurrentGameList.SelectedGame.Publisher, Converter={StaticResource StringLengthVisibilityConverter}}">
                            <TextBlock Text="Publisher:"    
                                       IsHitTestVisible="False"
                                       Foreground="DarkGray" TextWrapping="Wrap" TextTrimming="None" 
                                       VerticalAlignment="Stretch" HorizontalAlignment="Stretch" TextAlignment="Left" 
                                       FontFamily="Arial" FontSize="20"/>
                            <TextBlock Text="{Binding CurrentGameList.SelectedGame.Publisher}"
                                       IsHitTestVisible="False"
                                   Foreground="WhiteSmoke" TextWrapping="Wrap" TextTrimming="None" 
                                   Margin="10,0,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" TextAlignment="Left" 
                                   FontFamily="Arial" FontSize="20"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Game Details - the option list (Play, Favorite, More like this, Rating).
                     One row per option in the same four equal grid rows the four hand-written
                     blocks used to occupy. -->
                <ItemsControl Grid.Row="3" Grid.RowSpan="4"
                              IsHitTestVisible="False"
                              Visibility="{Binding IsDisplayingMoreInfo, Converter={StaticResource BoolToVis}}"
                              Width="{Binding ActualWidth, ElementName=StackPanel_SelectedGameDetails}"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ItemsSource="{Binding GameDetailOptions.Options}"
                              ItemTemplate="{StaticResource GameDetailOptionRow}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="4" Columns="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>








            </Grid>

            <!-- Selected game background image -->
            <Grid Name="Grid_Selected_Game_Background"
                  IsHitTestVisible="False"
                  Grid.Row="0" 
                  Grid.RowSpan="{Binding IsDisplayingFeature, Converter={StaticResource FeatureToRowSpanConverter}}" 
                  Grid.Column="{Binding IsDisplayingFeature, Converter={StaticResource FeatureToColumnStartConverter}}"
                  Grid.ColumnSpan="{Binding IsDisplayingFeature, Converter={StaticResource FeatureToColumnSpanConverter}}"
                  Panel.ZIndex="200">

                <!-- Black background behind selected game background image to make gradient opacity mask work -->
                <Rectangle Name="Image_Selected_Background_Black"
                           IsHitTestVisible="False"
                           HorizontalAlignment="Stretch" 
                           VerticalAlignment="Stretch"
                           Panel.ZIndex="210">
                    <Rectangle.Fill>
                        <SolidColorBrush Color="Black"/>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Background image for selected game -->
                <Image Name="Image_Displayed_BackgroundImage"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       IsHitTestVisible="False"
                       Stretch="UniformToFill"
                       Panel.ZIndex="220"
                       ClipToBounds="True"
                       MaxHeight="{Binding ActualHeight, ElementName=Grid_Selected_Game_Background}"
                       MaxWidth="{Binding ActualWidth, ElementName=Grid_Selected_Game_Background}"
                       RenderOptions.BitmapScalingMode="HighQuality" >
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <LinearGradientBrush.GradientStops>
                                <GradientStop Offset="0" Color="Transparent"/>
                                <GradientStop Offset="0.2" Color="Black"/>
                                <GradientStop Offset="0.8" Color="Black"/>
                                <GradientStop Offset="1" Color="Transparent"/>
                            </LinearGradientBrush.GradientStops>
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>

                <Image Name="Image_Active_BackgroundImage"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Stretch="UniformToFill"
                       IsHitTestVisible="False"
                       Panel.ZIndex="230"
                       Opacity="0"
                       ClipToBounds="True"
                       MaxHeight="{Binding ActualHeight, ElementName=Grid_Selected_Game_Background}"
                       MaxWidth="{Binding ActualWidth, ElementName=Grid_Selected_Game_Background}"
                       RenderOptions.BitmapScalingMode="HighQuality" >
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <LinearGradientBrush.GradientStops>
                                <GradientStop Offset="0" Color="Transparent"/>
                                <GradientStop Offset="0.2" Color="Black"/>
                                <GradientStop Offset="0.8" Color="Black"/>
                                <GradientStop Offset="1" Color="Black"/>
                            </LinearGradientBrush.GradientStops>
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>
            </Grid>

            <!-- Selected game video -->
            <Grid Name="Grid_Selected_Game_Video"
                  IsHitTestVisible="False"
                  Grid.Row="0" 
                  Grid.RowSpan="{Binding IsDisplayingFeature, Converter={StaticResource FeatureToRowSpanConverter}}" 
                  Grid.Column="{Binding IsDisplayingFeature, Converter={StaticResource FeatureToColumnStartConverter}}"
                  Grid.ColumnSpan="{Binding IsDisplayingFeature, Converter={StaticResource FeatureToColumnSpanConverter}}"
                  Panel.ZIndex="100">
                <MediaElement Name="Video_SelectedGame"
                              IsHitTestVisible="False"
                              Volume="{Binding VideoVolume}"                              
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Uniform"
                              LoadedBehavior="Manual"
                              Panel.ZIndex="110"
                              MediaOpened="Video_SelectedGame_MediaOpened"
                              MediaEnded="Video_SelectedGame_MediaEnded"
                              MediaFailed="Video_SelectedGame_MediaFailed">
                </MediaElement>
                <Image  Name="Image_Bezel"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Panel.ZIndex="120"
                        Stretch="Uniform">
                </Image>
                <Grid.RenderTransform>
                    <TranslateTransform>
                        <TranslateTransform.Y>
                            <MultiBinding Converter="{StaticResource FeatureVideoOffsetConverter}">
                                <Binding Path="IsDisplayingFeature"/>
                                <Binding Path="IsDisplayingMoreInfo"/>
                                <Binding ElementName="CurrentListGrid" Path="ActualHeight"/>
                            </MultiBinding>
                        </TranslateTransform.Y>
                    </TranslateTransform>
                </Grid.RenderTransform>
            </Grid>

            
            <!-- Zoomed Box -->
            <!-- Darken the background when displaying the zoomed box -->
            <Rectangle Grid.Row="0" Grid.RowSpan="18"
                       Grid.Column="0" Grid.ColumnSpan="32"
                       IsHitTestVisible="False"
                       Fill="Black"  Opacity="0.85"
                       Panel.ZIndex="701"
                       Visibility="{Binding IsZoomingBox, Converter={StaticResource BoolToVis}}">
            </Rectangle>

            <Image Name="Image_ZoomedBox"
                Panel.ZIndex="702"
                Grid.Row="0" Grid.RowSpan="18"
                Grid.Column="0" Grid.ColumnSpan="32"
                IsHitTestVisible="False"
                Source="{Binding CurrentGameList.SelectedGame.GameFiles.BigFrontImage}"
                HorizontalAlignment="Center" 
                VerticalAlignment="Stretch"
                RenderOptions.BitmapScalingMode="HighQuality" 
                Margin="2,2,2,2"
                Visibility="{Binding IsZoomingBox, Converter={StaticResource BoolToVis}}"
                Stretch="Uniform"/>
            
            <Grid Name="GameListGrid"
                  IsHitTestVisible="False"
                  Grid.Row="8"
                  Grid.RowSpan="10"
                  Grid.Column="0"
                  Grid.ColumnSpan="32"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Panel.ZIndex="700">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <!-- current games List -->
                    <RowDefinition Height="1*"/>
                    <!-- next games list -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="31*"/>
                </Grid.ColumnDefinitions>
                <Grid.RenderTransform>
                    <TranslateTransform>
                        <TranslateTransform.Y>
                            <MultiBinding Converter="{StaticResource FeatureOffsetConverter}">
                                <Binding Path="IsDisplayingFeature"/>
                                <Binding Path="IsDisplayingMoreInfo"/>
                                <Binding ElementName="CurrentListGrid" Path="ActualHeight"/>
                            </MultiBinding>
                        </TranslateTransform.Y>
                    </TranslateTransform>
                </Grid.RenderTransform>

                <!-- Current List Games -->
                <Grid Name="CurrentListGrid"
                      IsHitTestVisible="False"
                  Grid.Row="0"
                  Grid.RowSpan="1"
                  Grid.Column="1"
                  Grid.ColumnSpan="1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="5*"/>
                    </Grid.RowDefinitions>
                    <TextBlock  Name="TextBlock_CurrentGameListDescription"
                                IsHitTestVisible="False"
                                Grid.Row="0"
                                Grid.RowSpan="1"
                                FontFamily="Calibri" 
                                FontWeight="ExtraBold"
                                FontSize="28" 
                                Foreground="GhostWhite"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                TextAlignment="Left"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Text="{Binding CurrentGameList.ListDescription}">
                        <!-- While listening, the voice overlay draws the heard phrase in this
                             exact spot, so this one gets out of the way. Opacity rather than
                             Visibility: the settings icon's Height is bound to this element's
                             ActualHeight, and collapsing it would shrink the gear to nothing and
                             pop it back when the search ended. -->
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VoiceSearchPhase}" Value="Listening">
                                        <Setter Property="Opacity" Value="0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding VoiceSearchPhase}" Value="NoMatch">
                                        <Setter Property="Opacity" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Name="GameImages" 
                                IsHitTestVisible="False"
                                Grid.Row="1"
                                Grid.RowSpan="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                        <Border BorderThickness="2" BorderBrush="AntiqueWhite" IsHitTestVisible="False" Margin="{Binding FrontImageMargin}">
                            <Image Name="Image_Game1"
                                   IsHitTestVisible="False"
                                   Source="{Binding CurrentGameList.SelectedGame.GameFiles.FrontImageSource}"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Stretch"
                                   RenderOptions.BitmapScalingMode="HighQuality" 
                                   Stretch="Uniform"/>
                        </Border>

                        <!-- The row after the selected game. One template instead of eleven
                             near-identical Image elements. UpcomingGames is fixed length and its
                             entries are replaced in place, so a move updates only the containers
                             whose game actually changed rather than regenerating the row.
                             The margin comes off the view model, not the item, so it is bound
                             through the root element rather than the template's data context. -->
                        <ItemsControl ItemsSource="{Binding CurrentGameList.UpcomingGames}"
                                      IsHitTestVisible="False"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Stretch"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Image IsHitTestVisible="False"
                                           Source="{Binding GameFiles.FrontImageSource}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Stretch"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Margin="{Binding DataContext.FrontImageMargin, ElementName=MainWindowUserControl}"
                                           Stretch="Uniform"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- Previous game in current list -->
                <Grid Name="CurrentListPrev1GameGrid"
                      IsHitTestVisible="False"
                  Grid.Row="0"
                  Grid.RowSpan="1"
                  Grid.Column="1"
                  Grid.ColumnSpan="1"                      
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="5*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid.RenderTransform>
                        <TranslateTransform>
                            <TranslateTransform.X>
                                <MultiBinding Converter="{StaticResource PreviousGameOffset}">
                                    <Binding Path="ActualWidth" ElementName="Image_PreviousGame"/>
                                    <Binding Path="FrontImageMargin.Left"/>
                                    <Binding Path="FrontImageMargin.Right"/>
                                </MultiBinding>
                            </TranslateTransform.X>
                        </TranslateTransform>
                    </Grid.RenderTransform>
                    
                    <StackPanel Name="CurrentListPrev1GameImage" 
                                IsHitTestVisible="False"
                                Grid.Row="1"
                                Grid.RowSpan="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                        <Image Name="Image_PreviousGame"
                               IsHitTestVisible="False"
                           Source="{Binding CurrentGameList.PreviousGame.GameFiles.FrontImageSource}"
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Stretch"
                           RenderOptions.BitmapScalingMode="HighQuality" 
                           Opacity="0.25"
                           Margin="{Binding FrontImageMargin}"                               
                           Stretch="Uniform">
                        </Image>
                    </StackPanel>
                </Grid>

                <!-- Next list game images -->
                <Grid Name="NextListGrid"
                      IsHitTestVisible="False"
                  Grid.Row="0"
                  Grid.RowSpan="1"
                  Grid.Column="1"
                  Grid.ColumnSpan="1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="5*"/>
                    </Grid.RowDefinitions>
                    <Grid.RenderTransform>
                        <TranslateTransform Y="{Binding ActualHeight,ElementName=NextListGrid}"/>
                    </Grid.RenderTransform>
                    <TextBlock  
                        Name="TextBlock_NextGameListDescription"
                        IsHitTestVisible="False"
                        Grid.Row="0"
                        Grid.RowSpan="1"
                        FontFamily="Calibri" 
                        FontWeight="ExtraBold"
                        FontSize="28" 
                        Foreground="GhostWhite"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        TextAlignment="Left"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Text="{Binding NextGameList.ListDescription}">
                    </TextBlock>
                    <StackPanel Name="NextListGameImages" 
                                IsHitTestVisible="False"
                        Grid.Row="1"
                        Grid.RowSpan="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                        <Image Name="Image_NextListGame1"
                               IsHitTestVisible="False"
                            Source="{Binding NextGameList.SelectedGame.GameFiles.FrontImageSource}"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Stretch"
                            RenderOptions.BitmapScalingMode="HighQuality" 
                            Margin="{Binding FrontImageMargin}"
                            Stretch="Uniform"/>

                        <!-- The row after the selected game. One template instead of eleven
                             near-identical Image elements. UpcomingGames is fixed length and its
                             entries are replaced in place, so a move updates only the containers
                             whose game actually changed rather than regenerating the row.
                             The margin comes off the view model, not the item, so it is bound
                             through the root element rather than the template's data context. -->
                        <ItemsControl ItemsSource="{Binding NextGameList.UpcomingGames}"
                                      IsHitTestVisible="False"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Stretch"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Image IsHitTestVisible="False"
                                           Source="{Binding GameFiles.FrontImageSource}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Stretch"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Margin="{Binding DataContext.FrontImageMargin, ElementName=MainWindowUserControl}"
                                           Stretch="Uniform"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- Previous game in current list -->
                <Grid Name="NextListPrev1GameGrid"
                      IsHitTestVisible="False"
                      Grid.Row="0"
                      Grid.RowSpan="1"
                      Grid.Column="1"
                      Grid.ColumnSpan="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="5*"/>
                    </Grid.RowDefinitions>
                                        
                    <Grid.RenderTransform>
                        <TranslateTransform>
                            <TranslateTransform.X>
                                <MultiBinding Converter="{StaticResource PreviousGameOffset}">
                                    <Binding Path="ActualWidth" ElementName="Image_NextListPreviousGame"/>
                                    <Binding Path="FrontImageMargin.Left"/>
                                    <Binding Path="FrontImageMargin.Right"/>
                                </MultiBinding>
                            </TranslateTransform.X>
                            <TranslateTransform.Y>
                                <Binding Path="ActualHeight" ElementName="NextListPrev1GameGrid"/>
                            </TranslateTransform.Y>
                        </TranslateTransform>
                    </Grid.RenderTransform>

                    <StackPanel Name="NextListPrev1GameImage" 
                                IsHitTestVisible="False"
                                Grid.Row="1"
                                Grid.RowSpan="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                        <Image Name="Image_NextListPreviousGame"
                               IsHitTestVisible="False"
                               Source="{Binding NextGameList.PreviousGame.GameFiles.FrontImageSource}"
                               HorizontalAlignment="Left" 
                               VerticalAlignment="Stretch"
                               RenderOptions.BitmapScalingMode="HighQuality" 
                               Opacity="0.25"
                               Margin="{Binding FrontImageMargin}"
                               Stretch="Uniform">
                        </Image>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        <!-- END DISPLAYING RESULTS -->

        <!-- RECOGNIZING -->
        <!--
             Voice search happens in the current list's heading band, not in the middle of the
             screen. What the recogniser is hearing is drawn where the list title goes - and when
             results arrive that is exactly what it becomes, because a result list is named after
             what was said. The text does not move; the boxes change underneath it.

             The row and column definitions below deliberately mirror the DISPLAYING RESULTS grid
             and GameListGrid inside it, so the phrase lands on the heading rather than near it.
             They have to be duplicated rather than shared: z-order in WPF is hierarchical, so the
             real heading - nested inside GameListGrid - cannot be drawn above a scrim that is
             GameListGrid's sibling. Change either grid's proportions and this one has to follow.

             Explicit z-index: the error overlay is 1000 and attract mode is 900, and this used to
             sit above them both only because it happens to be last in the canvas.
        -->
        <Grid   Background="Transparent"
                IsHitTestVisible="False"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Panel.ZIndex="950"
                Width="{Binding ActualWidth, ElementName=MainWindowUserControl}"
                Height="{Binding ActualHeight, ElementName=MainWindowUserControl}">
            <Grid.Style>
                <!-- A trigger on the phase rather than a converter over a bool: the same shape
                     the game detail options use, and it extends to a new phase without one.

                     Fades in so the state change is not a cut, and leaves instantly - the phrase
                     it is showing is replaced by an identical heading at the same pixel, and
                     anything gradual would turn an invisible handover into a visible one. -->
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="Opacity" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding VoiceSearchPhase}" Value="Listening">
                            <Setter Property="Visibility" Value="Visible"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="VoiceSearchFadeIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <!-- hand the property back, so the next search fades in again
                                     instead of starting from where this one left it -->
                                <StopStoryboard BeginStoryboardName="VoiceSearchFadeIn"/>
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- The "matched nothing" notice keeps the heading slot, but nothing else:
                             the scrim and the microphone mark below are gated on Listening, so
                             the library comes back to full brightness and the screen is the
                             user's again while the notice is still standing there. -->
                        <DataTrigger Binding="{Binding VoiceSearchPhase}" Value="NoMatch">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- mirrors the DISPLAYING RESULTS grid: 18 rows, and the 1/31 column split that
                 GameListGrid uses to indent the row from the settings icon -->
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="31*"/>
            </Grid.ColumnDefinitions>

            <!-- Hold the library back while listening, without losing it. It used to stay at full
                 brightness behind the indicator, so the screen did not read as having changed
                 state - and then at 0.7 it read as a modal takeover instead. -->
            <Rectangle  Grid.Row="0"
                        Grid.RowSpan="18"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Fill="Black"
                        Opacity="0.4">
                <Rectangle.Style>
                    <!-- Only while actually listening. A notice left standing afterwards must not
                         hold the library back - the user is browsing again by then. -->
                    <Style TargetType="Rectangle">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VoiceSearchPhase}" Value="Listening">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>

            <!-- mirrors GameListGrid: rows 8-17, of which the current list takes two thirds -->
            <Grid   Grid.Row="8"
                    Grid.RowSpan="10"
                    Grid.Column="1"
                    Grid.ColumnSpan="1"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <!-- current games list -->
                    <RowDefinition Height="1*"/>
                    <!-- next games list -->
                </Grid.RowDefinitions>

                <!-- mirrors CurrentListGrid: heading band, then the row of boxes -->
                <Grid   Grid.Row="0"
                        Grid.RowSpan="1"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="5*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.RowSpan="1"
                                IsHitTestVisible="False"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom">

                        <!-- Type matched to TextBlock_CurrentGameListDescription exactly: this is
                             the same words, in the same place, at the same size as the heading
                             that replaces it, so the handover cannot be seen. -->
                        <TextBlock  Name="TextBlock_VoiceSearchHeading"
                                    IsHitTestVisible="False"
                                    FontFamily="Calibri"
                                    FontWeight="ExtraBold"
                                    FontSize="28"
                                    TextTrimming="CharacterEllipsis"
                                    TextAlignment="Left"
                                    VerticalAlignment="Bottom">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- heard something: show it, in the heading's own colour -->
                                    <Setter Property="Text" Value="{Binding HeardPhrase}"/>
                                    <Setter Property="Foreground" Value="GhostWhite"/>
                                    <Style.Triggers>
                                        <!-- nothing heard yet: say what is going on, rather than
                                             showing a mark hovering over an empty space -->
                                        <DataTrigger Binding="{Binding HeardPhrase}" Value="{x:Null}">
                                            <Setter Property="Text" Value="Listening…"/>
                                            <Setter Property="Foreground" Value="#9AA3A0"/>
                                        </DataTrigger>

                                        <!-- Declared last so it wins: the notice phase also has a
                                             null HeardPhrase, and the trigger above would
                                             otherwise leave "Listening…" on screen after the
                                             search had finished. -->
                                        <DataTrigger Binding="{Binding VoiceSearchPhase}" Value="NoMatch">
                                            <Setter Property="Text" Value="{Binding VoiceSearchNotice}"/>
                                            <Setter Property="Foreground" Value="GhostWhite"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Live-microphone mark, in the green the match percentage already uses.
                             It sits after the phrase so the phrase's left edge is the heading's
                             left edge - a leading mark would indent the text and the handover
                             would jump sideways. It breathes rather than reacting to speech: the
                             phrase itself is what responds, and two things reacting at once reads
                             as noise. -->
                        <Ellipse    Name="Ellipse_ListeningPulse"
                                    Width="13"
                                    Height="13"
                                    Margin="14,0,0,7"
                                    VerticalAlignment="Bottom"
                                    IsHitTestVisible="False"
                                    Fill="#43C764"
                                    RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <!-- gone the moment listening stops, so the notice that
                                         follows is a message and not a live microphone -->
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VoiceSearchPhase}" Value="Listening">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="ListeningPulse">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1" To="0.3" Duration="0:0:0.85"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="1" To="0.7" Duration="0:0:0.85"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="1" To="0.7" Duration="0:0:0.85"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="ListeningPulse"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        <!-- END RECOGNIZING -->

    </Canvas>
</UserControl>
